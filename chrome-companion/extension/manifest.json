{
  "manifest_version": 3,
  "name": "Setlist YouTube Companion",
  "version": "1.0.2",
  "description": "Reuse one YouTube tab for Setlist song searches.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "https://www.youtube.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Setlist YouTube companion",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "105"
}
